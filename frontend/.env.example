# Where the Laravel API lives. No trailing slash.
#
# Local:      http://localhost:8000
# Production: https://api.your-domain.com
#
# Anything prefixed VITE_ is compiled into the JavaScript bundle and is public.
# Never put a Google credential, a database password, or any other secret here —
# all of those belong in the Laravel environment on Forge.
VITE_API_URL=http://localhost:8000
