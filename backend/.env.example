APP_NAME="Memories"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (MySQL on Laravel Forge)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=memories
DB_USERNAME=forge
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cache / Queue / Session (Redis on Laravel Forge)
# ---------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1

CACHE_STORE=redis
CACHE_PREFIX=memories
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Must stay larger than the queue worker's --timeout (300s in DEPLOYMENT.md).
# If a job can still be running when this elapses, a second worker is handed
# the same job and the two race each other.
REDIS_QUEUE_RETRY_AFTER=360

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# The archive itself
# ---------------------------------------------------------------------------
# When true, anyone may view the timeline. Writes always require the owner.
ARCHIVE_PUBLIC=true
ARCHIVE_TITLE="Our Memories"
ARCHIVE_QUOTE="Every moment is worth remembering."

# How long a sign-in lasts, in minutes. Default 30 days. Leave empty for tokens
# that never expire — convenient, but a stolen device keeps access forever.
SANCTUM_TOKEN_EXPIRATION=43200

# Seeded by `php artisan archive:owner`. Never commit real values.
ARCHIVE_OWNER_NAME="Owner"
ARCHIVE_OWNER_EMAIL=
ARCHIVE_OWNER_PASSWORD=

# The deployed React app, exactly as the browser sees it — scheme and all.
# Comma-separate several (e.g. a custom domain plus the *.vercel.app one).
# A mismatch here is the single most common cause of "everything fails in the
# browser but works from curl".
FRONTEND_URL=https://memories.vercel.app

# Optional: regex patterns for preview deployments, e.g. ^https://memories-.*\.vercel\.app$
# Comma-separate. Leave blank unless you actually need it — a loose pattern
# here is what turns CORS into a hole.
FRONTEND_URL_PATTERNS=

# ---------------------------------------------------------------------------
# Google Drive — the one and only media vault
# ---------------------------------------------------------------------------
# "oauth" (recommended: files are owned by your own Google account and use its
# storage quota) or "service_account" (requires Google Workspace + a shared
# drive or domain-wide delegation, because bare service accounts have no quota).
GOOGLE_DRIVE_AUTH=oauth

# --- oauth ---------------------------------------------------------------
# Create an OAuth client (type: Web application) in Google Cloud Console, then
# run `php artisan drive:authorize` once and paste the refresh token here.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/drive/callback

# --- service_account ------------------------------------------------------
# Absolute path to the JSON key file, or the raw JSON base64-encoded.
GOOGLE_DRIVE_CREDENTIALS_PATH=
GOOGLE_DRIVE_CREDENTIALS_JSON_BASE64=
# Optional: user to impersonate via domain-wide delegation.
GOOGLE_DRIVE_IMPERSONATE=

# --- storage layout -------------------------------------------------------
# The app creates and owns this folder tree, so the narrow drive.file scope is
# enough. Leave the folder id blank unless you are pinning an existing folder
# (which requires the broader "drive" scope).
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_ROOT_FOLDER_NAME="Memory Archive"
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Group media into per-year subfolders under Images/ and Videos/.
GOOGLE_DRIVE_YEAR_FOLDERS=true
# Bytes sent to Drive per resumable-upload request. Must be a multiple of 256 KiB.
GOOGLE_DRIVE_UPLOAD_CHUNK_BYTES=8388608

# --- transfer tuning ------------------------------------------------------
# Defaults are sensible; set these only if Drive is slow or flaky for you.
# Seconds to wait on a single Drive API call, and on establishing the connection.
GOOGLE_DRIVE_TIMEOUT=120
GOOGLE_DRIVE_CONNECT_TIMEOUT=10
# Automatic retries for rate limits and backend errors.
GOOGLE_DRIVE_RETRIES=3

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Bytes per chunk sent from the browser to Laravel.
UPLOAD_CHUNK_BYTES=4194304
UPLOAD_SESSION_TTL_MINUTES=180
MEDIA_MAX_IMAGE_BYTES=52428800
MEDIA_MAX_VIDEO_BYTES=2147483648
MEDIA_MAX_FILES_PER_MEMORY=40

AUTH_GUARD=sanctum

# Ceiling for the cached image renditions, enforced weekly by
# `derivatives:prune`. Pure cache — anything trimmed regenerates on demand.
MEDIA_DERIVATIVE_CACHE_BYTES=8589934592
